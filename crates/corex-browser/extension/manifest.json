{
  "manifest_version": 3,
  "name": "Corex Browser Bridge",
  "version": "1.0.10",
  "key": "",
  "description": "Native browser companion for the Corex autonomous CLI agent. Controls designated tabs upon user request.",
  "permissions": ["debugger", "tabGroups", "alarms", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
